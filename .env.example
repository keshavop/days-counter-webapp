# Signs the login session cookie. Required in production: a long random string,
# e.g. `openssl rand -hex 32`. Changing it signs everyone out.
AUTH_SECRET=

# Google Drive CSV storage: the /exec URL of public/apps-script/Code.gs deployed as a
# web app, and the SECRET you set inside that script. Leave both empty to store the
# CSV files locally in data/ instead (handy for development).
DRIVE_SCRIPT_URL=
DRIVE_SCRIPT_SECRET=

# Optional: where the local CSV files go when DRIVE_SCRIPT_URL is empty (default: ./data).
DATA_DIR=
